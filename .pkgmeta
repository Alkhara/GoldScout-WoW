# Packaging rules for the BigWigs packager (used by .github/workflows/release.yml).
package-as: GoldScout

# The addon lives in GoldScout/ inside the repo; ship that folder as the addon.
move-folders:
  GoldScout/GoldScout: GoldScout

# Release notes for GitHub, CurseForge and Wago, written by the release
# workflow from CHANGELOG.md (tools/changelog.py).
manual-changelog:
  filename: RELEASE_NOTES.md
  markup-type: markdown

ignore:
  - CHANGELOG.md
  - RELEASE_NOTES.md
  - tools
  - tests
  - companion
  - server
  - site
  - wrangler.toml
  - README.md
  - CONTRIBUTING.md
  - docs
  - data
